DATABASE_URL=          # PostgreSQL接続URL
NEXTAUTH_SECRET=       # NextAuth用シークレット（openssl rand -hex 32 で生成）
NEXTAUTH_URL=          # アプリケーションのベースURL（例: http://localhost:3000）

# Email Ingestion
EMAIL_SOURCE_ENCRYPTION_KEY=   # 32バイトのランダム16進数文字列（openssl rand -hex 32 で生成）
INTERNAL_API_KEY=              # /api/emails/fetch のcron認証キー（openssl rand -hex 32 で生成）
ANTHROPIC_API_KEY=             # Claude API キー

# メール内容暗号化キー（base64 エンコードされた32バイト）
EMAIL_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here
# キー生成コマンド: node -e "const nacl = require('tweetnacl'); const util = require('tweetnacl-util'); console.log(util.encodeBase64(nacl.randomBytes(32)))"

# SMTP 設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vatch.jp
